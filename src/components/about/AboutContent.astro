---
import { createT } from '../../lib/i18n';
import type { EditorialBlock } from '../../lib/types';
import PageHeading from '../common/PageHeading.astro';
import ProseHtml from '../common/ProseHtml.astro';

interface Props {
  hero?: EditorialBlock;
  blocks: EditorialBlock[];
}

const { hero, blocks } = Astro.props;
const t = createT(Astro.locals.labels);
---

<section class="container-page page-y">
  <div data-reveal>
    <PageHeading kicker={hero?.subtitle} title={hero?.title || ''} />
    <ProseHtml html={hero?.content || ''} i18n="about.hero.content" class="prose-eld mt-(--space-block) max-w-3xl text-lg" />

    {hero?.image && (
      <figure class="media-frame mt-(--space-block) aspect-[16/9] lg:aspect-[2/1]">
        <img src={hero.image} alt={t('about.teamPhotoAlt')} data-i18n-attr="alt:about.teamPhotoAlt" class="h-full w-full object-cover" />
      </figure>
    )}
  </div>

  <div class="stack-y mt-(--space-section)">
    {blocks.map((block, index) => (
      <article class:list={['grid gap-8 lg:grid-cols-2 lg:items-center', index % 2 === 1 && 'lg:[&>div:first-child]:order-2']} data-reveal>
        <div>
          <h2 class="section-title" data-i18n={`about.${index}.title`} data-i18n-empty="hide" hidden={!block.title}>{block.title}</h2>
          <ProseHtml html={block.content || ''} i18n={`about.${index}.content`} class="prose-eld mt-5" />
        </div>
        {block.image && (
          <div class="media-frame min-h-[18rem]">
            <img src={block.image} alt="" class="h-full w-full object-cover" loading="lazy" />
          </div>
        )}
      </article>
    ))}
  </div>
</section>
