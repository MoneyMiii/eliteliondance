---
import InstagramIcon from './InstagramIcon';

interface Props {
  href: string;
  label: string;
  class?: string;
  padded?: boolean;
}

const { href, label, class: className = 'h-6 w-6', padded = true } = Astro.props;
---

<a
  href={href}
  class:list={[
    'inline-flex w-fit items-center justify-center rounded-full text-ink transition-colors hover:text-brand',
    padded && 'p-2',
  ]}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={label}
  data-i18n-attr="aria-label:cta.instagram"
>
  <InstagramIcon className={className} />
</a>
