---
import Button from './Button.astro';

interface Props {
  href?: string;
  label?: string;
  variant?: 'primary' | 'secondary';
  class?: string;
  i18n?: string;
}

const {
  href,
  label,
  variant = 'primary',
  class: className = 'mt-10 flex justify-center',
  i18n,
} = Astro.props;
---

<div class={className} data-i18n-show={i18n} hidden={!href || !label}>
  {href && (
    <Button href={href} variant={variant} i18n={i18n}>{label}</Button>
  )}
</div>
