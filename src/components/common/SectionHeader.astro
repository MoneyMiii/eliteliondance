---
import SectionTitle from './SectionTitle.astro';
import Button from './Button.astro';

interface Props {
  eyebrow?: string;
  title?: string;
  ctaLabel?: string;
  ctaUrl?: string;
  class?: string;
}

const { eyebrow, title = '', ctaLabel, ctaUrl, class: className = '' } = Astro.props;
const heading = Boolean(title || eyebrow);
const cta = Boolean(ctaLabel && ctaUrl);
---

{(heading || cta) && (
  <div class:list={['block-gap flex flex-col gap-6 md:flex-row md:items-end md:justify-between', className]}>
    {heading && <SectionTitle eyebrow={eyebrow} title={title} />}
    {cta && ctaUrl && (
      <Button href={ctaUrl} variant="secondary" class="text-center">
        {ctaLabel}
      </Button>
    )}
  </div>
)}
