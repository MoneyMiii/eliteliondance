---
import { distinctText } from '../../lib/format';

interface Props {
  eyebrow?: string;
  title: string;
}

const { eyebrow, title } = Astro.props;
const shownEyebrow = distinctText(eyebrow, title);
---

<header class="max-w-4xl">
  {shownEyebrow && <p class="eyebrow mb-4">{shownEyebrow}</p>}
  {title && <h2 class="section-title">{title}</h2>}
</header>
