---
import { createT } from '../../lib/i18n';
import type { EditorialBlock, EventItem } from '../../lib/types';
import SectionHeader from '../common/SectionHeader.astro';
import EventsGrid from './EventsGrid';
import EmptyState from '../common/EmptyState';

interface Props {
  events: EventItem[];
  hasMoreUpcoming?: boolean;
  content?: EditorialBlock;
}

const { events, hasMoreUpcoming = false, content } = Astro.props;
const logoMark = Astro.locals.settings?.logoMark;
const t = createT(Astro.locals.labels);
const moreHref = content?.ctaUrl
  ? `${content.ctaUrl}${content.ctaUrl.includes('?') ? '&' : '?'}filtre=avenir`
  : undefined;
---

<section class="container-page section-y">
  <SectionHeader
    eyebrow={content?.subtitle}
    title={content?.title}
    ctaLabel={content?.ctaLabel}
    ctaUrl={content?.ctaUrl}
  />
  {events.length ? (
    <EventsGrid
      locale={Astro.locals.locale}
      labels={Astro.locals.labels ?? {}}
      events={events}
      logoMark={logoMark}
      moreHref={hasMoreUpcoming ? moreHref : undefined}
      moreLabel={t('events.moreUpcoming')}
      client:load
    />
  ) : (
    t('events.noneUpcoming') && <EmptyState message={t('events.noneUpcoming')} />
  )}
</section>
