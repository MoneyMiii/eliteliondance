---
import type { Locale } from '../../lib/locale';
import { createT } from '../../lib/i18n';
import type { EditorialBlock, GalleryItem } from '../../lib/types';
import SectionTitle from '../common/SectionTitle.astro';
import GalleryCarousel from './GalleryCarousel';
import GalleryGrid from './GalleryGrid';
import EmptyState from '../common/EmptyState.astro';
import Button from '../common/Button.astro';

interface Props {
  locale: Locale;
  items: GalleryItem[];
  content?: EditorialBlock;
  preview?: boolean;
  heading?: boolean;
}

const { items, content, preview = false, heading = true } = Astro.props;
const labels = Astro.locals.labels ?? {};
const t = createT(labels, Astro.locals.locale);
const photos = preview ? items.slice(0, 8) : items;
---

<section class:list={[heading && 'section-y']}>
  {heading && (content?.title || content?.subtitle || (preview && content?.ctaUrl)) && (
    <div class="container-page block-gap flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <SectionTitle
        eyebrow={content?.subtitle}
        title={content?.title || ''}
      />
      {preview && content?.ctaLabel && content?.ctaUrl && (
        <Button href={content.ctaUrl} variant="secondary">{content.ctaLabel}</Button>
      )}
    </div>
  )}

  {photos.length ? (
    preview ? (
      <GalleryCarousel labels={labels} items={photos} client:load />
    ) : (
      <GalleryGrid labels={labels} items={photos} client:visible />
    )
  ) : (
    t('gallery.empty') && (
      <div class="container-page">
        <EmptyState message={t('gallery.empty')} />
      </div>
    )
  )}
</section>
