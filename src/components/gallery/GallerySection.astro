---
import { createT } from '../../lib/i18n';
import type { EditorialBlock, GalleryItem } from '../../lib/types';
import SectionHeader from '../common/SectionHeader.astro';
import GalleryCarousel from './GalleryCarousel';
import GalleryGrid from './GalleryGrid';
import EmptyState from '../common/EmptyState';

interface Props {
  items: GalleryItem[];
  content?: EditorialBlock;
  preview?: boolean;
  heading?: boolean;
}

const { items, content, preview = false, heading = true } = Astro.props;
const labels = Astro.locals.labels ?? {};
const t = createT(labels);
const photos = preview ? items.slice(0, 8) : items;
// En aperçu la section est déjà à l'intérieur d'une bande animée.
const revealOnScroll = !preview;
---

<section class:list={[heading && 'section-y']} data-reveal={revealOnScroll ? '' : undefined}>
  {heading && (
    <SectionHeader
      class="container-page"
      eyebrow={content?.subtitle}
      title={content?.title}
      ctaLabel={preview ? content?.ctaLabel : undefined}
      ctaUrl={preview ? content?.ctaUrl : undefined}
      i18nPrefix={heading ? 'home.gallery' : undefined}
    />
  )}

  {photos.length ? (
    preview ? (
      <GalleryCarousel labels={labels} items={photos} client:load />
    ) : (
      <GalleryGrid labels={labels} items={photos} client:visible />
    )
  ) : (
    t('gallery.empty') && (
      <div class="container-page">
        <EmptyState message={t('gallery.empty')} i18n="gallery.empty" />
      </div>
    )
  )}
</section>
