---
import Button from '../common/Button.astro';
import type { EditorialBlock } from '../../lib/types';
import { distinctText } from '../../lib/format';

interface Props {
  content?: EditorialBlock;
}

const { content } = Astro.props;
const title = content?.title || '';
const kicker = distinctText(content?.subtitle, title);
const primaryCta = content?.ctaLabel;
const primaryUrl = content?.ctaUrl;
const secondaryCta = content?.ctaSecondaryLabel;
const secondaryUrl = content?.ctaSecondaryUrl;
const video = content?.video;
const poster = content?.image;
const hasMedia = Boolean(video || poster);
const videoType = video?.includes('.webm') ? 'video/webm' : 'video/mp4';
---

<section class="relative isolate flex min-h-[80svh] items-end overflow-hidden bg-paper">
  {video ? (
    <video
      class="absolute inset-0 size-full object-cover"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      poster={poster}
      aria-hidden="true"
    >
      <source src={video} type={videoType} />
    </video>
  ) : poster ? (
    <img src={poster} alt="" class="absolute inset-0 h-full w-full object-cover kenburns" />
  ) : null}
  {hasMedia && <div class="overlay-scrim absolute inset-0"></div>}
  <div class="container-page relative z-10 pt-36 pb-[calc(var(--space-section)+var(--band-cut))]">
    <div class="flex flex-col gap-5">
      <p class:list={['eyebrow reveal', hasMedia && 'on-media']} data-i18n="home.hero.eyebrow" data-i18n-empty="hide" hidden={!kicker}>{kicker}</p>
      <h1 class:list={['display-title max-w-5xl reveal', hasMedia && 'on-media']} style="animation-delay: 120ms" data-i18n="home.hero.title">{title}</h1>
    </div>
    <div class="mt-10 flex flex-wrap gap-3 reveal" style="animation-delay: 220ms" data-i18n-show="home.hero.cta,home.hero.ctaSecondary" hidden={!((primaryCta && primaryUrl) || (secondaryCta && secondaryUrl))}>
      <span data-i18n-show="home.hero.cta" hidden={!(primaryCta && primaryUrl)}>
        {primaryUrl && <Button href={primaryUrl} i18n="home.hero.cta">{primaryCta}</Button>}
      </span>
      <span data-i18n-show="home.hero.ctaSecondary" hidden={!(secondaryCta && secondaryUrl)}>
        {secondaryUrl && (
          <Button href={secondaryUrl} variant="secondary" class="bg-paper" i18n="home.hero.ctaSecondary">{secondaryCta}</Button>
        )}
      </span>
    </div>
  </div>
</section>
