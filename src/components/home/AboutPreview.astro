---
import { createT } from '../../lib/i18n';
import type { EditorialBlock } from '../../lib/types';
import SectionTitle from '../common/SectionTitle.astro';
import SectionCta from '../common/SectionCta.astro';
import ProseHtml from '../common/ProseHtml.astro';

interface Props {
  content?: EditorialBlock;
}

const { content } = Astro.props;
const t = createT(Astro.locals.labels);
---

<section class="container-page section-y">
  <div class="block-gap max-w-3xl">
    {(content?.title || content?.subtitle) && (
      <SectionTitle eyebrow={content?.subtitle} title={content?.title || ''} />
    )}
    {content?.content && <ProseHtml html={content.content} class="prose-eld mt-6 text-lg" />}
    <SectionCta href={content?.ctaUrl} label={content?.ctaLabel} variant="secondary" class="mt-8" />
  </div>
  {content?.image && (
    <figure class="media-frame aspect-[16/9] lg:aspect-[2/1]">
      <img
        src={content.image}
        alt={t('about.teamPhotoAlt')}
        class="h-full w-full object-cover object-center"
        loading="lazy"
      />
    </figure>
  )}
</section>
