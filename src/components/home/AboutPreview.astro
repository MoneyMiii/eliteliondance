---
import { createT } from '../../lib/i18n';
import type { EditorialBlock } from '../../lib/types';
import Button from '../common/Button.astro';
import { sanitizeHtml } from '../../lib/localize';
import { distinctText } from '../../lib/format';

interface Props {
  content?: EditorialBlock;
}

const { content } = Astro.props;
const t = createT(Astro.locals.labels);
const title = content?.title || '';
const kicker = distinctText(content?.subtitle, title);
---

<section class="container-page section-y">
  <div class="block-gap max-w-3xl">
    {kicker && <p class="eyebrow">{kicker}</p>}
    {title && <h2 class:list={['section-title', kicker && 'mt-4']}>{title}</h2>}
    {content?.content && (
      <div class="prose-eld mt-6 text-lg">
        <div set:html={sanitizeHtml(content.content)} />
      </div>
    )}
    {content?.ctaLabel && content?.ctaUrl && (
      <div class="mt-8">
        <Button href={content.ctaUrl} variant="secondary">
          {content.ctaLabel}
        </Button>
      </div>
    )}
  </div>
  {content?.image && (
    <figure class="media-frame aspect-[16/9] lg:aspect-[2/1]">
      <img
        src={content.image}
        alt={t('about.teamPhotoAlt')}
        class="h-full w-full object-cover object-center"
        loading="lazy"
      />
    </figure>
  )}
</section>
