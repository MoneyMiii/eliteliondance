---
import HeroVideo from '../hero/HeroVideo.astro';
import IntroSection from './IntroSection.astro';
import ServicesSection from '../services/ServicesSection.astro';
import UpcomingEventsSection from '../events/UpcomingEventsSection.astro';
import GallerySection from '../gallery/GallerySection.astro';
import AboutPreview from './AboutPreview.astro';
import TeamSection from '../team/TeamSection.astro';
import InstagramSection from './InstagramSection.astro';
import type { HomeData } from '../../lib/api';
import type { Locale } from '../../lib/locale';

interface Props {
  locale: Locale;
  home: HomeData;
}

const { locale, home } = Astro.props;
---

{home.sections.map((section) => {
  switch (section.key) {
    case 'hero':
      return (
        <HeroVideo
          locale={locale}
          content={home.content['home.hero']}
          intro={home.content['home.intro']}
        />
      );
    case 'intro':
      return <IntroSection locale={locale} content={home.content['home.intro']} />;
    case 'services':
      return <ServicesSection locale={locale} content={home.content['home.services']} services={home.services} />;
    case 'events':
      return (
        <UpcomingEventsSection
          locale={locale}
          events={home.upcomingEvents}
          hasMoreUpcoming={home.hasMoreUpcoming}
          content={home.content['home.events']}
          logoMark={home.logoMark}
        />
      );
    case 'gallery':
      return <GallerySection locale={locale} items={home.gallery} content={home.content['home.gallery']} preview />;
    case 'about':
      return <AboutPreview locale={locale} content={home.content['home.about']} />;
    case 'team':
      return <TeamSection locale={locale} members={home.team} content={home.content['home.team']} logoMark={home.logoMark} />;
    case 'instagram':
      return (
        <InstagramSection locale={locale} content={home.content['home.instagram']} instagramUrl={home.instagramUrl} />
      );
    default:
      return null;
  }
})}
