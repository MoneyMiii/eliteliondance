---
import HeroVideo from '../hero/HeroVideo.astro';
import IntroSection from './IntroSection.astro';
import ServicesSection from '../services/ServicesSection.astro';
import UpcomingEventsSection from '../events/UpcomingEventsSection.astro';
import GallerySection from '../gallery/GallerySection.astro';
import AboutPreview from './AboutPreview.astro';
import TeamSection from '../team/TeamSection.astro';
import InstagramSection from './InstagramSection.astro';
import type { HomeData } from '../../lib/api';
import type { HomepageSectionKey } from '../../lib/types';

interface Props {
  home: HomeData;
}

const PRESENTATION = new Set<HomepageSectionKey>(['hero', 'intro']);

const CUTS: Record<HomepageSectionKey, { dir: 'a' | 'b'; depth: string }> = {
  hero: { dir: 'a', depth: '2vw' },
  intro: { dir: 'a', depth: '12vw' },
  services: { dir: 'b', depth: '2vw' },
  events: { dir: 'a', depth: '7.5vw' },
  gallery: { dir: 'a', depth: '3vw' },
  about: { dir: 'b', depth: '8.5vw' },
  team: { dir: 'a', depth: '2.25vw' },
  instagram: { dir: 'a', depth: '6vw' },
};

const { home } = Astro.props;
const rest = home.sections.filter((section) => !PRESENTATION.has(section.key));
const bands = home.sections.map((section) => ({
  section,
  dark: !PRESENTATION.has(section.key) && rest.findIndex((item) => item.key === section.key) % 2 === 0,
}));
---

{bands.map(({ section, dark }, index) => {
  const cut = CUTS[section.key];
  const above = index > 0 ? CUTS[bands[index - 1].section.key] : null;
  return (
  <div
    class:list={[
      dark ? 'band-dark' : 'band-light',
      cut.dir === 'a' ? 'band-cut-a' : 'band-cut-b',
      section.key === 'hero' && 'band-hero',
      above?.dir === 'a' && 'reveal-from-a',
      above?.dir === 'b' && 'reveal-from-b',
    ]}
    style={`z-index: ${bands.length - index}; --band-cut: ${cut.depth}; --band-overlap: ${above?.depth ?? '0px'}`}
  >
    {section.key === 'hero' ? (
      <HeroVideo content={home.content['home.hero']} />
    ) : (
      <div data-reveal="wipe">
        {section.key === 'intro' && <IntroSection content={home.content['home.intro']} />}
        {section.key === 'services' && (
          <ServicesSection content={home.content['home.services']} services={home.services} />
        )}
        {section.key === 'events' && (
          <UpcomingEventsSection
            events={home.upcomingEvents}
            hasMoreUpcoming={home.hasMoreUpcoming}
            content={home.content['home.events']}
          />
        )}
        {section.key === 'gallery' && (
          <GallerySection items={home.gallery} content={home.content['home.gallery']} preview />
        )}
        {section.key === 'about' && <AboutPreview content={home.content['home.about']} />}
        {section.key === 'team' && (
          <TeamSection members={home.team} content={home.content['home.team']} />
        )}
        {section.key === 'instagram' && (
          <InstagramSection content={home.content['home.instagram']} />
        )}
      </div>
    )}
  </div>
  );
})}
