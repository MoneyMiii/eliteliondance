---
import type { EditorialBlock } from '../../lib/types';
import SectionTitle from '../common/SectionTitle.astro';
import ProseHtml from '../common/ProseHtml.astro';

interface Props {
  content?: EditorialBlock;
}

const { content } = Astro.props;
---

<section class="container-page section-y">
  <div class="max-w-3xl">
    {(content?.title || content?.subtitle) && (
      <SectionTitle eyebrow={content?.subtitle} title={content?.title || ''} />
    )}
    {content?.content && <ProseHtml html={content.content} class="prose-eld mt-6 text-lg" />}
  </div>
</section>
