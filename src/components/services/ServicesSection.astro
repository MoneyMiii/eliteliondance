---
import type { EditorialBlock, ServiceItem } from '../../lib/types';
import SectionTitle from '../common/SectionTitle.astro';
import ServiceCard from './ServiceCard.astro';
import Button from '../common/Button.astro';

interface Props {
  content?: EditorialBlock;
  services: ServiceItem[];
}

const { content, services } = Astro.props;
const anchor = content?.anchor;
const heading = Boolean(content?.title || content?.subtitle);
---

<section class="container-page section-y">
  {heading && (
    <div id={anchor} class:list={['block-gap', anchor && 'anchor-offset']}>
      <SectionTitle
        eyebrow={content?.subtitle}
        title={content?.title || ''}
      />
    </div>
  )}
  {
    services.length > 0 && (
      <div class="grid auto-rows-[26rem] gap-5 sm:grid-cols-2">
        {services.map((service) => (
          <ServiceCard icon={service.icon} photo={service.photo} title={service.title} description={service.description} />
        ))}
      </div>
    )
  }
  {content?.ctaLabel && content?.ctaUrl && (
    <div class="mt-10 flex justify-center">
      <Button href={content.ctaUrl}>{content.ctaLabel}</Button>
    </div>
  )}
</section>
