---
import { createT } from '../../lib/i18n';
import type { EditorialBlock, TeamMember } from '../../lib/types';
import SectionTitle from '../common/SectionTitle.astro';
import TeamCarousel from './TeamCarousel';
import EmptyState from '../common/EmptyState';
import SectionCta from '../common/SectionCta.astro';

interface Props {
  members: TeamMember[];
  content?: EditorialBlock;
}

const { members, content } = Astro.props;
const logoMark = Astro.locals.settings?.logoMark;
const t = createT(Astro.locals.labels);
const labels = Astro.locals.labels ?? {};
const anchor = content?.anchor;
const heading = Boolean(content?.title || content?.subtitle);
---

<section class:list={['section-y', anchor && 'min-h-[calc(100svh-var(--header-height))]']}>
  {heading && (
    <div id={anchor} class:list={['container-page block-gap', anchor && 'anchor-offset']}>
      <SectionTitle
        eyebrow={content?.subtitle}
        title={content?.title || ''}
        i18nPrefix="home.team"
      />
    </div>
  )}
  {members.length ? (
    <div class="container-page">
      <TeamCarousel labels={labels} members={members} logoMark={logoMark} client:load />
    </div>
  ) : (
    t('empty.team') && (
      <div class="container-page">
        <EmptyState message={t('empty.team')} i18n="empty.team" />
      </div>
    )
  )}
  <SectionCta href={content?.ctaUrl} label={content?.ctaLabel} class="container-page mt-10 flex justify-center" i18n="home.team.cta" />
</section>
