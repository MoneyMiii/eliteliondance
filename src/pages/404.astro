---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/common/Button.astro';
import PageHeading from '../components/common/PageHeading.astro';
import { createT } from '../lib/i18n';

const t = createT(Astro.locals.labels);
const homeHref = Astro.locals.navLinks.find((link) => link.href === '/')?.href || Astro.locals.navLinks[0]?.href || '/';
---

<BaseLayout path="/404" title={t('notFound.code')}>
  <section class="container-page page-y flex min-h-[70vh] flex-col items-start justify-center">
    <PageHeading kicker={t('notFound.code')} title={t('notFound.title')} />
    <div class="mt-(--space-block)">
      <Button href={homeHref}>{t('notFound.back')}</Button>
    </div>
  </section>
</BaseLayout>
