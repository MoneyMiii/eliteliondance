---
import BaseLayout from '../layouts/BaseLayout.astro';
import AboutContent from '../components/about/AboutContent.astro';
import { getAboutBlocks, getPage } from '../lib/api';
import { takeCms } from '../lib/cms';
import { stripHtml } from '../lib/localize';

const locale = Astro.locals.locale;
const [heroResult, blocksResult] = Astro.locals.cmsAvailable
  ? await Promise.all([getPage('about', locale), getAboutBlocks(locale)])
  : [];
const hero = heroResult ? takeCms(Astro.locals, heroResult) : undefined;
const blocks = blocksResult ? takeCms(Astro.locals, blocksResult) ?? [] : [];
---

<BaseLayout
  path="/a-propos"
  title={hero?.title}
  description={stripHtml(hero?.content || hero?.subtitle || '')}
>
  <AboutContent hero={hero} blocks={blocks} />
</BaseLayout>
