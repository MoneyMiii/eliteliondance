---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeading from '../components/common/PageHeading.astro';
import ContactForm from '../components/contact/ContactForm';
import { getContactServices, getPage } from '../lib/api';
import { takeCms } from '../lib/cms';
import { createT } from '../lib/i18n';

const locale = Astro.locals.locale;
const t = createT(Astro.locals.labels);
const [heroResult, servicesResult] = Astro.locals.cmsAvailable
  ? await Promise.all([getPage('contact', locale), getContactServices(locale)])
  : [];
const hero = heroResult ? takeCms(Astro.locals, heroResult) : undefined;
const services = servicesResult?.ok ? servicesResult.data : [];
---

<BaseLayout
  path="/contact"
  title={hero?.title || t('nav.contact')}
  description={hero?.subtitle || t('contact.intro')}
>
  <section class="container-page page-y grid gap-12 lg:grid-cols-[0.9fr_1.1fr]">
    <PageHeading
      kicker={hero?.title ? t('contact.kicker') : undefined}
      title={hero?.title || t('contact.title')}
      lede={hero?.subtitle || t('contact.intro')}
    />
    <ContactForm labels={Astro.locals.labels ?? {}} services={services} client:load />
  </section>
</BaseLayout>
