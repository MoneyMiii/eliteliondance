---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeading from '../components/common/PageHeading.astro';
import ContactForm from '../components/contact/ContactForm';
import { getLayoutData, getPage, getServices } from '../lib/api';
import { createT } from '../lib/i18n';
import { getRequestLocale } from '../lib/request-locale';
import type { EditorialBlock, Partner } from '../lib/types';

const locale = getRequestLocale(Astro.cookies);
const t = createT(Astro.locals.labels, locale);
const labels = Astro.locals.labels ?? {};
let partners: Partner[] = [];
let instagramUrl = '';
let hero: EditorialBlock | undefined;
let services: { id: string; title: string }[] = [];
const [layout, heroResult, servicesResult] = await Promise.all([
  getLayoutData(locale),
  getPage('contact', locale),
  getServices(locale),
]);
if (layout.ok && heroResult.ok) {
  partners = layout.data.partners;
  instagramUrl = layout.data.settings.instagramUrl;
  hero = heroResult.data;
} else {
  Astro.locals.cmsAvailable = false;
}
if (servicesResult.ok) {
  services = servicesResult.data.map((service) => ({ id: service.id, title: service.title }));
}
---

<BaseLayout
  locale={locale}
  path="/contact"
  title={hero?.title || t('nav.contact')}
  description={hero?.subtitle || t('contact.intro')}
  instagramUrl={instagramUrl}
  partners={partners}
>
  <section class="container-page page-y grid gap-12 lg:grid-cols-[0.9fr_1.1fr]">
    <PageHeading
      kicker={hero?.title ? t('contact.kicker') : undefined}
      title={hero?.title || t('contact.title')}
      lede={hero?.subtitle || t('contact.intro')}
    />
    <ContactForm labels={labels} services={services} client:load />
  </section>
</BaseLayout>
