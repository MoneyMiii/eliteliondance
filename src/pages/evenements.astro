---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeading from '../components/common/PageHeading.astro';
import EventsList from '../components/events/EventsList';
import { getEvents } from '../lib/api';
import { takeCms } from '../lib/cms';
import { parseEventFilter } from '../lib/events';
import { createT } from '../lib/i18n';

const locale = Astro.locals.locale;
const t = createT(Astro.locals.labels);
const events = Astro.locals.cmsAvailable
  ? takeCms(Astro.locals, await getEvents(locale)) ?? []
  : [];
---

<BaseLayout path="/evenements" title={t('nav.events')} description={t('events.allTitle')}>
  <section class="container-page page-y" data-reveal>
    <PageHeading kicker={t('events.kicker')} title={t('events.allTitle')} />
    <div class="mt-(--space-block)">
      <EventsList
        locale={locale}
        labels={Astro.locals.labels ?? {}}
        events={events}
        initialFilter={parseEventFilter(Astro.url.searchParams.get('filtre'))}
        logoMark={Astro.locals.settings?.logoMark}
        client:load
      />
    </div>
  </section>
</BaseLayout>
