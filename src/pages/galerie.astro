---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeading from '../components/common/PageHeading.astro';
import GallerySection from '../components/gallery/GallerySection.astro';
import { getGallery, getPartners } from '../lib/api';
import { createT } from '../lib/i18n';
import { getRequestLocale } from '../lib/request-locale';
import type { GalleryItem, Partner } from '../lib/types';

const locale = getRequestLocale(Astro.cookies);
const t = createT(Astro.locals.labels);
let items: GalleryItem[] = [];
let partners: Partner[] = [];
const instagramUrl = Astro.locals.settings?.instagramUrl ?? '';
if (Astro.locals.cmsAvailable) {
  const [gallery, partnersResult] = await Promise.all([getGallery(), getPartners()]);
  if (!gallery.ok || !partnersResult.ok) {
    Astro.locals.cmsAvailable = false;
  } else {
    items = gallery.data;
    partners = partnersResult.data;
  }
}
---

<BaseLayout
  locale={locale}
  path="/galerie"
  title={t('nav.gallery')}
  description={t('gallery.title')}
  instagramUrl={instagramUrl}
  partners={partners}
>
  <div class="page-y">
    <div class="container-page block-gap">
      <PageHeading kicker={t('gallery.kicker')} title={t('gallery.title')} />
    </div>
    <GallerySection items={items} heading={false} />
  </div>
</BaseLayout>
