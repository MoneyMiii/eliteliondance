---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeSections from '../components/home/HomeSections.astro';
import { getHomeData } from '../lib/api';
import { takeCms } from '../lib/cms';
import { stripHtml } from '../lib/localize';

const { locale, settings } = Astro.locals;
const home = Astro.locals.cmsAvailable && settings
  ? takeCms(Astro.locals, await getHomeData(locale, settings))
  : undefined;
const hero = home?.content['home.hero'];
---

<BaseLayout
  path="/"
  title={hero?.title}
  description={stripHtml(hero?.subtitle || hero?.content || '')}
  image={hero?.image}
>
  {home && <HomeSections home={home} />}
</BaseLayout>
